{
  "version": 2,
  "functions": {
    "api/salvar.js": {
      "memory": 256
    },
    "api/contatos.js": {
      "memory": 256
    },
    "api/relatorios.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/estoque-sync-diario.js": {
      "memory": 256,
      "maxDuration": 300
    },
    "api/estoque.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/financeiro.js": {
      "memory": 256,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/ping?empresa=tf",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/relatorios?acao=sync-diario",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/estoque-sync-diario",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/estoque-sync-diario?empresa=tf",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/financeiro?acao=sync-diario",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/financeiro?acao=sync-diario&empresa=tf",
      "schedule": "15 8 * * *"
    }
  ]
}
