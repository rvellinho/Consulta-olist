OLIST_CLIENT_SECRET=

# Mesmas credenciais acima, mas da conta Olist da Timbers/Fabrique ("TF").
# Ver api/_lib/empresas.js - deixar em branco até a TF ser configurada.
OLIST_TOKEN_TF=
OLIST_CLIENT_ID_TF=
OLIST_CLIENT_SECRET_TF=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
